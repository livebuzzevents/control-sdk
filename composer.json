{
  "name": "livebuzz/control-sdk",
  "description": "LiveBuzz Control SDK",
  "keywords": [
    "livebuzz",
    "control",
    "sdk"
  ],
  "license": "proprietary",
  "type": "package",
  "require": {
    "php": "^8.3",
    "livebuzz/essentials-sdk": "4.4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "fakerphp/faker": "^1.9.1",
    "mockery/mockery": "^1.6.12",
    "phpunit/phpunit": "~12.0"
  },
  "autoload": {
    "psr-4": {
      "Buzz\\Control\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "kylekatarnls/update-helper": true
    }
  }
}
